@@ -0,0 +1,285 @@
+import GLib from 'gi://GLib';
+import Meta from 'gi://Meta';
+import * as BoxPointer from 'resource:///org/gnome/shell/ui/boxpointer.js';
+import * as Main from 'resource:///org/gnome/shell/ui/main.js';
+
+import { prof_count } from '../../../conveniences/tahoe_prof.js';
+
+// tahoe glass: the surfaces of one popup move together. While the popup opens or closes (its
+// BoxPointer eases opacity, translation and scale), a quick settings submenu grows or shrinks, or a
+// notification banner slides, one frame callback per popup moves every glass surface with it,
+// instead of each surface re-running its full update for every signal of every ancestor. The
+// glass keeps the backdrop it has (or captures it once, where the popup will come to rest) and
+// goes live again when the last transition is over.
+
+const POPUP_PROPERTIES = ['opacity', 'translation-x', 'translation-y', 'scale-x', 'scale-y'];
+const BANNER_PROPERTIES = ['opacity', 'x', 'y', 'scale-x', 'scale-y'];
+const SUBMENU_PROPERTIES = ['height'];
+const SUBMENU_CONTAINER_CLASS = 'quick-toggle-menu-container';
+// started together with a submenu's opening or closing, and running on after it: the panel's
+// dimming (an effect property, so there is no signal to start from)
+const QUICK_SETTINGS_DIM = '@effects.dim.brightness';
+
+class PopupMotionGroup {
+    constructor(root, properties) {
+        this.root = root;
+        this.surfaces = new Set();
+        this.movers = new Map();
+        this.followers = [];
+        this.settling = false;
+        this.holds = 0;
+        this.frame_id = 0;
+        this.overlay_id = 0;
+        this.watch(root, properties);
+        this.watch_submenus();
+    }
+
+    watch(actor, properties) {
+        if (this.movers.has(actor))
+            return;
+        const ids = properties.map(property =>
+            actor.connect(`notify::${property}`, () => this.maybe_begin()));
+        ids.push(actor.connect('destroy', () => this.unwatch(actor)));
+        this.movers.set(actor, { properties, ids });
+    }
+
+    unwatch(actor) {
+        const mover = this.movers.get(actor);
+        if (!mover)
+            return;
+        mover.ids.forEach(id => actor.disconnect(id));
+        this.movers.delete(actor);
+        this.followers = this.followers.filter(([follower]) => follower !== actor);
+    }
+
+    // quick settings submenus grow inside the panel's overlay and push the pieces below them
+    watch_submenus() {
+        const quick_settings = Main.panel.statusArea.quickSettings?.menu;
+        if (!quick_settings || quick_settings._boxPointer !== this.root)
+            return;
+        const overlay = quick_settings._overlay;
+        this.followers.push([this.root, QUICK_SETTINGS_DIM]);
+        const watch_child = child => {
+            if (!child.has_style_class_name?.(SUBMENU_CONTAINER_CLASS))
+                return;
+            this.watch(child, SUBMENU_PROPERTIES);
+            // a submenu closes by fading its rows out first, then shrinking
+            const box = child.get_first_child();
+            if (box)
+                this.watch(box, ['opacity']);
+        };
+        overlay.get_children().forEach(watch_child);
+        this.overlay = overlay;
+        this.overlay_id = overlay.connect('child-added', (_, child) => watch_child(child));
+    }
+
+    is_moving() {
+        if (this.holds > 0)
+            return true;
+        for (const [actor, { properties }] of this.movers) {
+            for (const property of properties) {
+                if (actor.get_transition(property))
+                    return true;
+            }
+        }
+        return this.settling && this.followers.some(([actor, name]) => actor.get_transition(name));
+    }
+
+    /// An animation of its own (tahoe-motion) moves this popup: keep it settling until release.
+    hold() {
+        this.holds++;
+        this.maybe_begin();
+    }
+
+    release() {
+        this.holds = Math.max(0, this.holds - 1);
+    }
+
+    maybe_begin() {
+        if (this.settling || !this.is_moving())
+            return;
+
+        this.settling = true;
+        prof_count('motion.settle');
+        this.surfaces.forEach(surface => surface.begin_settle());
+        // runs once per frame, after the transitions have advanced and before the layout
+        this.frame_id = global.compositor.get_laters().add(
+            Meta.LaterType.BEFORE_REDRAW,
+            () => this.frame()
+        );
+    }
+
+    frame() {
+        if (!this.is_moving()) {
+            this.frame_id = 0;
+            this.end();
+            return GLib.SOURCE_REMOVE;
+        }
+        prof_count('motion.frame');
+        this.surfaces.forEach(surface => surface.follow());
+        return GLib.SOURCE_CONTINUE;
+    }
+
+    end() {
+        this.settling = false;
+        this.surfaces.forEach(surface => surface.end_settle());
+    }
+
+    /// Where a point of the popup (in stage coordinates) will be once its own open or close
+    /// transition is over: the BoxPointer's translation and scale taken out. Used to capture the
+    /// backdrop once, at the place the glass comes to rest.
+    rest_point(x, y) {
+        const root = this.root;
+        if (!(root instanceof BoxPointer.BoxPointer))
+            return [x, y];
+        const [ox, oy] = root.get_transformed_position();
+        const sx = root.scale_x || 1;
+        const sy = root.scale_y || 1;
+        const [px, py] = root.pivot_point ? [root.pivot_point.x, root.pivot_point.y] : [0, 0];
