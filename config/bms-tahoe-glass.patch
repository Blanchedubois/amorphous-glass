         : 1;
 }
 
+// tahoe glass: a GTK4 popover with an arrow keeps a 12 px strip for it on the side facing its
+// button (fixed in gtkpopover.c, whatever the CSS says), so its window is larger than the menu it
+// shows. The glass covers the menu only, edge on edge, so its rows sit exactly the menu gap in.
+// The menu fills the rest of the window as long as the GTK glass block gives it no box-shadow
+// (a shadow would add its extent around it).
+const NO_INSETS = { top: 0, right: 0, bottom: 0, left: 0 };
+const GTK_POPOVER_INSET = 0;
+const GTK_POPOVER_TAIL = 12;
+// A context menu opens at the pointer, 0 or 1 px from it; a menu button's popover opens past the
+// button the pointer clicked, at least this far from it.
+const TAIL_POINTER_GAP = 3;
+
+/// The insets from an app menu's frame to the menu it draws. `pointer` ([x, y]) is where the
+/// pointer was when the menu opened: on the button, so on the arrow's side of the menu.
+export function app_menu_insets(frame, pointer) {
+    const insets = {
+        top: GTK_POPOVER_INSET, right: GTK_POPOVER_INSET,
+        bottom: GTK_POPOVER_INSET, left: GTK_POPOVER_INSET,
+    };
+    if (!pointer)
+        return insets;
+    const [px, py] = pointer;
+    const across_x = px >= frame.x && px < frame.x + frame.width;
+    const across_y = py >= frame.y && py < frame.y + frame.height;
+    if (across_x && py <= frame.y - TAIL_POINTER_GAP)
+        insets.top += GTK_POPOVER_TAIL;
+    else if (across_x && py >= frame.y + frame.height - 1 + TAIL_POINTER_GAP)
+        insets.bottom += GTK_POPOVER_TAIL;
+    else if (across_y && px <= frame.x - TAIL_POINTER_GAP)
+        insets.left += GTK_POPOVER_TAIL;
+    else if (across_y && px >= frame.x + frame.width - 1 + TAIL_POINTER_GAP)
+        insets.right += GTK_POPOVER_TAIL;
+    return insets;
+}
+
+function inset_rect(rect, insets) {
+    return {
+        x: rect.x + insets.left,
+        y: rect.y + insets.top,
+        width: Math.max(1, rect.width - insets.left - insets.right),
+        height: Math.max(1, rect.height - insets.top - insets.bottom),
+    };
+}
