new file mode 100644
index 0000000..d59f7a2
--- /dev/null
+++ b/src/conveniences/tahoe_prof.js
@@ -0,0 +1,21 @@
+import GLib from 'gi://GLib';
+
+/// Tahoe glass frame probe: time spent in the blur code while quick settings is open, read by the
+/// tahoe-probe extension through the shell's shared global object. Off unless that probe is on.
+export const prof = globalThis.__tahoeProf ??= { on: false, time: {}, count: {} };
+
+export function prof_begin() {
+    return prof.on ? GLib.get_monotonic_time() : 0;
+}
+
+export function prof_end(name, t0) {
+    if (!t0)
+        return;
+    prof.time[name] = (prof.time[name] ?? 0) + GLib.get_monotonic_time() - t0;
+    prof.count[name] = (prof.count[name] ?? 0) + 1;
+}
+
+export function prof_count(name) {
+    if (prof.on)
+        prof.count[name] = (prof.count[name] ?? 0) + 1;
+}
