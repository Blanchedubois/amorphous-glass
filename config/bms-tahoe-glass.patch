+        const pivot_y = py * root.height;
+        // transformed position = origin + translation + pivot + scale * (0 - pivot)
+        const origin_x = ox - root.translation_x - pivot_x + sx * pivot_x;
+        const origin_y = oy - root.translation_y - pivot_y + sy * pivot_y;
+        return [
+            origin_x + (x - ox) / sx,
+            origin_y + (y - oy) / sy,
+        ];
+    }
+
+    add(surface) {
+        this.surfaces.add(surface);
+        if (this.settling)
+            surface.begin_settle();
+    }
+
+    remove(surface) {
+        this.surfaces.delete(surface);
+    }
+
+    destroy() {
+        if (this.frame_id)
+            global.compositor.get_laters().remove(this.frame_id);
+        this.frame_id = 0;
+        if (this.overlay_id)
+            this.overlay.disconnect(this.overlay_id);
+        this.overlay_id = 0;
+        [...this.movers.keys()].forEach(actor => this.unwatch(actor));
+        this.followers = [];
+        this.surfaces.clear();
+    }
+}
+
+const groups = new Map();
+
+/// tahoe glass: what the tahoe-motion extension drives, through the shell's shared global (the
+/// extensions cannot import each other). `root` is a popup's BoxPointer or the banner bin.
+const api = {
+    version: 1,
+    hold(root) {
+        groups.get(root)?.hold();
+        return groups.has(root);
+    },
+    release(root) {
+        groups.get(root)?.release();
+    },
+    /// the glass surfaces of a popup: their target actors and a reveal setter (target coordinates)
+    surfaces(root) {
+        const group = groups.get(root);
+        return group ? [...group.surfaces].map(surface => ({
+            target: surface.target,
+            corner_radius: surface.get_corner_radius(),
+            /// the glass's rectangle in the target's coordinates, once it has been placed
+            glass_rect: () => {
+                const local = surface.placement.local;
+                return local
+                    ? { x: local.x, y: local.y, width: local.width, height: local.height }
