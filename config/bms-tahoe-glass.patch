+            },
+            set_reveal: reveal => surface.set_reveal(reveal),
+        })) : [];
+    },
+    /// the glass of a GTK app's menu or popover window (components/applications), once Blur My
+    /// Shell has made it: its rectangle in the window actor's coordinates and a reveal setter in
+    /// the same coordinates; null until then
+    app_menu(meta_window) {
+        const actor = meta_window?.blur_actor;
+        const pipeline = meta_window?.bg_manager?._bms_pipeline;
+        if (!actor || !pipeline?.set_reveal)
+            return null;
+        return {
+            blur_actor: actor,
+            corner_radius: pipeline.cornerRadius ?? 17,
+            glass_rect: () => ({ x: actor.x, y: actor.y, width: actor.width, height: actor.height }),
+            set_reveal: reveal => pipeline.set_reveal(reveal && {
+                ...reveal, x: reveal.x - actor.x, y: reveal.y - actor.y,
+            }),
+        };
+    },
+
+    /// counts for stress tests (tools/headless): motion groups, holds, surfaces settling or frozen,
+    /// running frame callbacks and signal handlers held by the popup glass
+    debug() {
+        const out = { groups: groups.size, holds: 0, frame_callbacks: 0, surfaces: 0, settling: 0, frozen: 0, handlers: 0 };
+        for (const group of groups.values()) {
+            out.holds += group.holds;
+            out.frame_callbacks += group.frame_id ? 1 : 0;
+            out.handlers += [...group.movers.values()].reduce((n, mover) => n + mover.ids.length, 0);
+            for (const surface of group.surfaces) {
+                out.surfaces++;
+                out.settling += surface.settling ? 1 : 0;
+                out.frozen += surface.frozen ? 1 : 0;
+                for (const record of surface.signals?.connections?.records?.values() ?? [])
+                    out.handlers += record.ids.size + (record.destroy_id ? 1 : 0);
+            }
+        }
+        return out;
+    },
+
+    /// the popup's motion root for an actor in it, or null when it has no glass
+    root_of(actor) {
+        const found = actor ? find_root(actor) : null;
+        return found && groups.has(found.root) ? found.root : null;
+    },
+};
+globalThis.__tahoeGlass = api;
+
+function find_root(target) {
+    const banner_bin = Main.messageTray?._bannerBin;
+    for (let actor = target; actor; actor = actor.get_parent()) {
+        if (actor instanceof BoxPointer.BoxPointer)
+            return { root: actor, properties: POPUP_PROPERTIES };
+        // quick settings submenus live in an overlay beside the panel's BoxPointer, not in it
+        const box_pointer = actor._delegate?._boxPointer;
+        if (box_pointer instanceof BoxPointer.BoxPointer)
+            return { root: box_pointer, properties: POPUP_PROPERTIES };
+        if (actor === banner_bin)
+            return { root: actor, properties: BANNER_PROPERTIES };
+    }
+    return null;
+}
+
+/// The motion group of a surface's popup, or null for surfaces that are not in a popup (dialogs,
+/// the screenshot UI, OSDs), which keep their own updates.
+export function join_motion_group(surface) {
+    const found = find_root(surface.target);
+    if (!found)
+        return null;
+    let group = groups.get(found.root);
+    if (!group) {
+        group = new PopupMotionGroup(found.root, found.properties);
+        groups.set(found.root, group);
+    }
+    group.add(surface);
+    return group;
+}
+
+export function leave_motion_group(surface, group) {
+    if (!group)
+        return;
+    group.remove(surface);
+    if (group.surfaces.size === 0) {
+        group.destroy();
+        groups.delete(group.root);
+    }
+}
