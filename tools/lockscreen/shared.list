# files of extensions/tahoe-widgets@cachyos-tahoe that the lock screen extension carries as exact
# copies in its widgets/ folder (an installed extension must be self-contained): source dest
glass.js glass.js
mpris.js mpris.js
swirl.js swirl.js
music.js music.js
palette.js palette.js
stylesheet.css widgets.css
icons icons
weather.js weather.js
calendar.js calendar.js
clocks.js clocks.js
# the Liquid Glass pane (a shader over a shape, no Blur My Shell): the login screen's, shared
../tahoe-gdm@cachyos-tahoe/glass.js paneglass.js
# GNOME's menus on frosted glass while locked (the system menu), as on the login screen
../tahoe-gdm@cachyos-tahoe/menus.js glassmenus.js
# the clock's glass panes (date and time), shared with the login screen
../tahoe-gdm@cachyos-tahoe/clockpanes.js clockpanes.js
